{
  "info": {
    "name": "qrmenu-api",
    "description": "Postman collection for qrmenu-api. Uses {{baseUrl}} and stores auth tokens / created resource IDs in the selected environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Business Auth",
      "item": [
        {
          "name": "Register Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee House\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/register",
            "description": "Create a business account and store the returned tokens in the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refreshToken', body.refresh_token);",
                  "if (body.business && body.business._id) pm.environment.set('businessId', body.business._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refreshToken', body.refresh_token);",
                  "if (body.business && body.business._id) pm.environment.set('businessId', body.business._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Business Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Business Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\"\n}"
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/forgot-password",
            "description": "Sends a password reset email if the business account exists."
          }
        },
        {
          "name": "Edit Business",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee House Updated\"\n}"
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/edit"
          }
        },
        {
          "name": "Delete Business",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/{{apiVersion}}/business/auth/delete"
          }
        }
      ]
    },
